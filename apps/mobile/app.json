{
  "expo": {
    "name": "stemtrack-capture",
    "slug": "stemtrack-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./image/stemtrack-logo.png",
    "scheme": "stemtrackcapture",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./image/assets/android-icon-foreground.png",
        "backgroundImage": "./image/assets/android-icon-background.png",
        "monochromeImage": "./image/assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.stemtrackcapture"
    },
    "web": {
      "output": "single",
      "favicon": "./image/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "STEMTrack uses the camera to capture classroom learning evidence.",
          "microphonePermission": "STEMTrack uses the microphone to record audio during classroom sessions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "STEMTrack uses the microphone for settled teacher voice debriefs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./image/assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "f0c7d1a2-3b6e-4f5c-a9a8-0d8b1e5f3c4e"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
